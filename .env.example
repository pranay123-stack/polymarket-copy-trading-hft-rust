# ============================================================================
# Polymarket Copy-Trader — configuration
#
# Copy to `.env` and edit. `.env` is gitignored and must NEVER be committed.
# Every risk limit below has a conservative built-in default: omitting a
# variable TIGHTENS the limit, it never loosens it.
# ============================================================================

# ---------------------------------------------------------------- mode
# paper | live | replay
APP_MODE=paper

# LIVE SAFETY INTERLOCK.
# `APP_MODE=live` alone is NOT enough. Both of these must be set, independently,
# or the system refuses to start live execution. This exists so a single
# forgotten variable can never arm real trading.
LIVE_TRADING_ENABLED=false

# Populate the dashboard with synthetic, clearly-labelled DEMO activity.
# Refused outright in live mode — demo data must never enter a real book.
DEMO_DATA=false

# Recorded session for `--mode replay`.
# REPLAY_FILE=./tests/fixtures/session.json

# ---------------------------------------------------------------- endpoints
# Defaults are the verified production hosts; override only for testing.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# The wallet-attributed trade feed — the copy-trading signal source.
POLYMARKET_RTDS_WS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
HTTP_TIMEOUT_MS=10000

# ---------------------------------------------------------------- target wallets
# Format: address:nickname:copy_ratio:max_trade_usd:max_exposure_usd
# Only the address is required. Separate multiple wallets with commas.
# Wallets can also be managed at runtime via POST /api/target-wallets.
TARGET_WALLETS=

# ---------------------------------------------------------------- risk limits
# Enforced on EVERY order before it can reach an execution adapter.
MAX_TRADE_USD=100
MIN_TRADE_USD=5
MAX_POSITION_USD=1000
MAX_MARKET_EXPOSURE_USD=1000
MAX_PORTFOLIO_EXPOSURE_USD=5000
MAX_DAILY_LOSS_USD=100
MAX_OPEN_ORDERS=20
MAX_SLIPPAGE_BPS=50
MIN_LIQUIDITY_USD=50
MAX_MARKET_DATA_AGE_MS=30000

# An additional, tighter cap that applies ONLY in live mode.
MAX_LIVE_ORDER_USD=50

# ---------------------------------------------------------------- paper simulation
# Defaults are deliberately pessimistic: a paper fill should be harder to obtain
# than a live one, so paper results understate rather than flatter.
PAPER_STARTING_CASH_USD=10000
SIMULATED_LATENCY_MS=45
SIMULATED_LATENCY_JITTER_MS=20
SIMULATED_FEE_BPS=0
SIMULATED_SLIPPAGE_BPS=10
PARTIAL_FILL_ENABLED=true
FILL_PROBABILITY=0.92
REJECT_PROBABILITY=0.01
# Fixing the seed makes an entire paper session reproducible.
SIM_RNG_SEED=42

# ---------------------------------------------------------------- live credentials
# REQUIRED in live mode. NEVER commit real values.
# The private key is used for EIP-712 (L1) order signing and is never logged.
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
# L2 HMAC credentials, derived from L1 via POST /auth/api-key.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# ---------------------------------------------------------------- storage
DATABASE_URL=postgres://copytrader:copytrader@localhost:5432/copytrader
DB_MAX_CONNECTIONS=10
# REDIS_URL=redis://localhost:6379
# Run with no database at all. Trading continues; durable audit and crash
# recovery do not. The health endpoint reports this honestly.
EPHEMERAL_STORAGE=false

# ---------------------------------------------------------------- server
SERVER_BIND_ADDR=0.0.0.0
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173
# Bearer token for mutating endpoints (kill switch, wallet config, paper reset).
# Optional in paper/replay for zero-setup demos; REQUIRED in live mode.
# API_AUTH_TOKEN=

# ---------------------------------------------------------------- logging
LOG_JSON=false
RUST_LOG=info,sqlx=warn,hyper=warn
